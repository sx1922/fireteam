{
    "theme_id": "coldwar_military",
    "name": "Cold War Military",

    "palette": {
        "primary":          "#c4a35a",
        "secondary":        "#8a8560",
        "background":       "#2a2e1e",
        "surface":           "#1e2218",
        "border":            "#3a3520",
        "text":              "#d4c9a0",
        "text_muted":        "#8a8560",
        "accent":            "#b87333",
        "success":           "#5a7a3a",
        "warning":           "#c4a35a",
        "danger":            "#8b3a2a",
        "info":              "#6a8a9a",
        "squad_ally":        "#6a9a4a",
        "squad_leader":      "#c4a35a",
        "marker_waypoint":   "#b87333",
        "marker_enemy":      "#8b3a2a",
        "marker_objective":  "#c4a35a",
        "marker_danger":    "#b87333",
        "marker_rally":     "#6a8a9a",
        "marker_medical":    "#7a5a6a"
